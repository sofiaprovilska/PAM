Adapter - 
Adaptee(obietk adoptowany) Uczen  ->  Osoba(adapter) -implementuje> IOsoba(target)
                                     Klient ^
zależności, dziedziczenie, implementacja, korzysta
https://www.geeksforgeeks.org/system-design/adapter-pattern/

void main() {
    StaryCzajnik staryCzajnik = new StaryCzajnik(20.0);
    ICzajnik czajnik = new CzajnikAdapter(staryCzajnik);
    System.out.println(czajnik.TemperaturaWFahrenheit());
}
public class StaryCzajnik{
    public double celsius;

    public StaryCzajnik(double celsius){
        this.celsius = celsius;
    }
    public double TemperaturaWCelsius(){
        return celsius;
    }
}

class CzajnikAdapter implements ICzajnik{
    public StaryCzajnik staryCzajnik;
    public double fahrenheit;
    public CzajnikAdapter(StaryCzajnik staryCzajnik){
        this.staryCzajnik = staryCzajnik;
    }
    public double TemperaturaWFahrenheit(){
        return staryCzajnik.TemperaturaWCelsius() * 1.8 +32;
    }
}
public interface ICzajnik{
    double TemperaturaWFahrenheit();
}


